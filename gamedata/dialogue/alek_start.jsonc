{
  "id": "alek_start",
  "start": [
    { "node": "repeat_narration", "when": { "flag": "alek_talked", "equals": 1 } },
    { "node": "first_narration" }
  ],
  "speakers": [
    { "id": "player", "name": "Banec", "role": "player",
      "portrait": "assets/ui/portraits/player.png" },
    { "id": "alek", "name": "Alek Endhelm", "role": "npc", "entity": "alek",
      "portrait": "assets/ui/portraits/alek.png" },
    { "id": "narrator", "name": "Narrator", "role": "narrator" }
  ],
  "nodes": [
    {
      "id": "first_narration", "speaker": "narrator",
      "text": "The muscular fellow in front of you has the air of a troublemaker about him. Scars all over his body are evidence of his readiness to use the sword he is carrying. He eyes you with undisguised distaste as you approach.",
      "next": "first_insult"
    },
    {
      "id": "first_insult", "speaker": "alek",
      "text": "And who do we have here? A damn freak Half-Elf I say!",
      "choices": [
        { "text": "That's Banec, you ass! I'm working for Lady Silverhair.",
          "actions": [{ "op": "set", "flag": "alek_talked", "value": 1 }],
          "next": "dismiss_employer" },
        { "text": "I don't like you either, friend. But unfortunately, I need to talk to you.",
          "actions": [{ "op": "set", "flag": "alek_talked", "value": 1 }],
          "next": "what_want" }
      ]
    },
    {
      "id": "dismiss_employer", "speaker": "alek",
      "text": "For Lady Silverhair, eh? Now that scares the shit out of me, Half-Elf. Go and bother somebody else!",
      "end": true
    },
    {
      "id": "what_want", "speaker": "alek",
      "text": "You? Tell me, what would one of your sort want from Alek Endhelm?",
      "choices": [
        { "text": "I need some questions answered, concerning the theft.", "next": "not_so_quick" },
        { "text": "I'm just wondering what someone like you is doing at Waste's Edge.", "next": "none_business" }
      ]
    },
    {
      "id": "none_business", "speaker": "alek",
      "text": "That's none of your business Half-Elf. Don't waste my time, will ya!?",
      "next": "valuables"
    },
    {
      "id": "valuables", "speaker": "player",
      "text": "So it's none of my business if valuables disappear around here and my mistress is held responsible?",
      "next": "dislikes_implication"
    },
    {
      "id": "dislikes_implication", "speaker": "alek",
      "text": "I don't like the implication. It's not wise going around, calling other people thieves.",
      "choices": [
        { "text": "So far, I've called you nothing. But if you don't help me with a few answers, I might change my mind.",
          "next": "need_answers" },
        { "text": "I daresay being caught eavesdropping on the victim just before his gems are stolen is unwise as well.",
          "when": { "flag": "know_alek_eavesdrop", "equals": 1 },
          "next": "alek_eavesdrop_accusation" }
      ]
    },
    {
      "id": "need_answers", "speaker": "player",
      "text": "So far, I've called you nothing. But if you don't help me with a few answers, I might change my mind.",
      "next": "answer_questions"
    },
    {
      "id": "not_so_quick", "speaker": "alek",
      "text": "Not so quick! Who do you think you are, walking around pestering other people?",
      "choices": [
        { "text": "If you must know, I'm working for Lady Silverhair.", "next": "answer_questions" },
        { "text": "I'm here to get to the bottom of the matter. So if you don't want to share Silverhair's fate, you had better answer my questions.", "next": "answer_questions" }
      ]
    },
    {
      "id": "answer_questions", "speaker": "alek",
      "text": "To hell with you, Half-Elf. What do you want to know?",
      "choices": [
        { "text": "What is your business here, then?", "next": "business_answer" },
        { "text": "Master Orloth says your chamber is below ground, next to the Dwarf's. So did you hear anything unusual in the night of the theft?",
          "when": { "flag": "know_aleks_room", "equals": 1 },
          "next": "ask_about_cellar" },
        { "text": "What were you doing outside the parlour during negotiations? Trying to spy on Master Fingolson?",
          "when": { "all": [
            { "flag": "know_alek_eavesdrop", "equals": 1 },
            { "flag": "asked_alek_eavesdrop", "equals": 0 }
          ] },
          "actions": [{ "op": "set", "flag": "asked_alek_eavesdrop", "value": 1 }],
          "next": "not_spying" }
      ]
    },
    {
      "id": "repeat_narration", "speaker": "narrator",
      "text": "Endhelm puts a threatening grin on his face as he sees you walking towards him.",
      "next": "repeat_player"
    },
    {
      "id": "repeat_player", "speaker": "player",
      "text": "Listen! Need we really go through all this crap again?",
      "next": "repeat_reply"
    },
    {
      "id": "repeat_reply", "speaker": "alek",
      "text": "You're getting on my nerves, Half-Elf. Go ahead then, ask your stupid questions.",
      "choices": [
        { "text": "Actually, there is nothing you could possibly tell me.", "next": "leave" },
        { "text": "What is your business here, then?", "next": "business_answer" },
        { "text": "Master Orloth says your chamber is below ground, next to the Dwarf's. So did you hear anything unusual in the night of the theft?",
          "when": { "flag": "know_aleks_room", "equals": 1 },
          "next": "ask_about_cellar" },
        { "text": "What were you doing outside the parlour during negotiations? Trying to spy on Master Fingolson?",
          "when": { "all": [
            { "flag": "know_alek_eavesdrop", "equals": 1 },
            { "flag": "asked_alek_eavesdrop", "equals": 0 }
          ] },
          "actions": [{ "op": "set", "flag": "asked_alek_eavesdrop", "value": 1 }],
          "next": "not_spying" }
      ]
    },
    {
      "id": "question_menu", "speaker": "alek",
      "text": "Now do you have any dumb questions left, or can I go back to my drink?",
      "choices": [
        { "text": "So what is your business here, then?", "next": "business_answer" },
        { "text": "Master Orloth says your chamber is below ground, next to the Dwarf's. So did you hear anything unusual in the night of the theft?",
          "when": { "flag": "know_aleks_room", "equals": 1 },
          "next": "ask_about_cellar" },
        { "text": "What were you doing outside the parlour during negotiations? Trying to spy on Master Fingolson?",
          "when": { "all": [
            { "flag": "know_alek_eavesdrop", "equals": 1 },
            { "flag": "asked_alek_eavesdrop", "equals": 0 }
          ] },
          "actions": [{ "op": "set", "flag": "asked_alek_eavesdrop", "value": 1 }],
          "next": "not_spying" }
      ]
    },
    {
      "id": "alek_eavesdrop_accusation", "speaker": "alek",
      "text": "Who told you? The little gritsucker? He'll say what his master tells him to say, haven't you noticed?",
      "next": "alek_eavesdrop_admits"
    },
    {
      "id": "alek_eavesdrop_admits", "speaker": "alek",
      "text": "Come on, don't make a face like that, Half-Elf. Of course I was there. I was on my way to see what all the shouting was about. Looked like my skills might have been needed.",
      "next": "silverhair_burst_out"
    },
    {
      "id": "silverhair_burst_out", "speaker": "alek",
      "text": "Next moment, the door's burstin' open and your lovely mistress rushes past ... - I don't think you could call that eavesdropping.",
      "choices": [
        { "text": "Leave the thinking to me and simply answer my questions, will you?", "next": "answer_questions" },
        { "text": "For what would they have needed your skills?", "next": "skills_answer" }
      ]
    },
    {
      "id": "alek_eavesdrop_threat", "speaker": "alek",
      "text": "Even if I was, I bet you could never prove it, Half-Elf. You wouldn't recognise a clue if someone pushed your pretty nose into it.",
      "next": "question_menu"
    },
    {
      "id": "business_answer", "speaker": "alek",
      "text": "If it makes you happy; I made camp here on my way back from Limebruck where I had an ... appointment, which is absolutely none of your concern. I'm just an innocent traveller caught in this bloody mess.",
      "next": "business_waste_of_time"
    },
    {
      "id": "business_waste_of_time", "speaker": "alek",
      "text": "So? Was that of any help? I shouldn't think so. A waste of time it was!",
      "choices": [
        { "text": "Well, that's it! I have enough of your useless blather. But I shall be watching you!", "next": "end_warning" }
      ]
    },
    {
      "id": "ask_about_cellar", "speaker": "player",
      "text": "Master Orloth says your chamber is below ground, next to the Dwarf's. So did you hear anything unusual in the night of the theft?",
      "next": "alek_heard_nothing"
    },
    {
      "id": "alek_heard_nothing", "speaker": "alek",
      "text": "No I didn't. But perhaps there wasn't anything unusual to hear that night.",
      "next": "what_do_you_mean"
    },
    {
      "id": "what_do_you_mean", "speaker": "player",
      "text": "What do you mean?",
      "next": "theft_before_bed"
    },
    {
      "id": "theft_before_bed", "speaker": "alek",
      "text": "You're a slow thinker, eh Half-Elf!? Hasn't it occurred to you that the theft might've already been committed by the time Fingolson went to bed?",
      "choices": [
        { "text": "Don't make me laugh. That's the most ridiculous thing I ever heard.", "next": "ridiculous" },
        { "text": "Do you have any proof of this?", "next": "ask_for_proof" },
        { "text": "That's impossible. Fingolson had the gems on him during the negotiations. And afterwards, either he or Erek were down in their room.", "next": "gems_guarded" }
      ]
    },
    {
      "id": "ridiculous", "speaker": "player",
      "text": "Don't make me laugh. That's the most ridiculous thing I ever heard.",
      "next": "different_company"
    },
    {
      "id": "different_company", "speaker": "alek",
      "text": "If you don't like what you hear from me, why don't you look for different company, Half-Elf?",
      "choices": [
        { "text": "Perhaps you are right. Any further conversation would be useless anyway. So I'll leave you ... for now!", "next": "leave" }
      ]
    },
    {
      "id": "ask_for_proof", "speaker": "player",
      "text": "Do you have any proof of this?",
      "next": "no_proof"
    },
    {
      "id": "no_proof", "speaker": "alek",
      "text": "I don't. But since you are so good in finding stuff out, this shouldn't be a problem for you!",
      "choices": [
        { "text": "Well, that's it! I have enough of your useless blather. But I shall be watching you!", "next": "end_warning" }
      ]
    },
    {
      "id": "gems_guarded", "speaker": "player",
      "text": "That's impossible. Fingolson had the gems on him during the negotiations. And afterwards, either he or Erek were down in their room.",
      "next": "rules_out_thieves"
    },
    {
      "id": "rules_out_thieves", "speaker": "alek",
      "text": "Well, that would rule out quite a few possible thieves, wouldn't it?",
      "choices": [
        { "text": "You want to tell me that Erek has taken the gems?", "next": "accuse_erek" }
      ]
    },
    {
      "id": "accuse_erek", "speaker": "player",
      "text": "You want to tell me that Erek has taken the gems?",
      "next": "ask_erek_who_packed"
    },
    {
      "id": "ask_erek_who_packed", "speaker": "alek",
      "text": "You don't believe me? Perhaps you should ask Erek who has packed them then!",
      "choices": [
        { "text": "Don't make me laugh. That's the most ridiculous thing I ever heard.",
          "actions": [{ "op": "set", "flag": "ask_packed_gems", "value": 1 }],
          "next": "different_company" },
        { "text": "Do you have any proof of this?",
          "actions": [{ "op": "set", "flag": "ask_packed_gems", "value": 1 }],
          "next": "no_proof" }
      ]
    },
    {
      "id": "not_spying", "speaker": "alek",
      "text": "Why should I \"spy\" on a conversation that could be heard up to Erinsford. Nah, I was about to look whether my skills might be needed.",
      "choices": [
        { "text": "For what would they have needed your skills?", "next": "skills_answer" },
        { "text": "Don't tell me you thought Fingolson would enrol you as his guard?", "next": "guard_answer" }
      ]
    },
    {
      "id": "skills_answer", "speaker": "alek",
      "text": "You disappoint me, Half-Elf. The poor Dwarfs were practically attacked by that furious woman. How should I know she wasn't about to turn them into toads or something?",
      "choices": [
        { "text": "Don't make me laugh. That's the most ridiculous thing I ever heard.", "next": "different_company" },
        { "text": "Don't tell me you thought Fingolson would enrol you as his guard?", "next": "guard_answer" }
      ]
    },
    {
      "id": "guard_answer", "speaker": "alek",
      "text": "So what? You think I stole his gems because he didn't accept my offer?",
      "choices": [
        { "text": "I think you wouldn't need any reason at all. However, until I find a clue as to your guilt, I'll have to leave you to yourself.", "next": "end_suspicion" }
      ]
    },
    {
      "id": "good_question", "speaker": "alek",
      "text": "Good question, isn't it! Now if I were you, Half-Elf, I'd be off to a quiet corner and made some use of what brain I had.",
      "choices": [
        { "text": "Perhaps you are right. Any further conversation would be useless anyway. So I'll leave you ... for now!", "next": "leave" },
        { "text": "Very funny! Should I ever need a fool, I'll send for you.", "next": "smartass_help" }
      ]
    },
    {
      "id": "smartass_help", "speaker": "alek",
      "text": "Just tryin' to help. But a smartass like you doesn't need any help, do you?",
      "choices": [
        { "text": "I certainly don't need yours. For all I know, you may well be the thief.", "next": "alek_eavesdrop_threat" },
        { "text": "Simply answering my questions would be help enough!", "next": "ask_anyway" }
      ]
    },
    {
      "id": "ask_anyway", "speaker": "alek",
      "text": "If you say so. Then go on, ask what you want, even if it's not getting you anywhere.",
      "choices": "question_menu"
    },
    {
      "id": "end_warning", "speaker": "player",
      "text": "Well, that's it! I have enough of your useless blather. But I shall be watching you!",
      "end": true
    },
    {
      "id": "end_suspicion", "speaker": "player",
      "text": "I think you wouldn't need any reason at all. However, until I find a clue as to your guilt, I'll have to leave you to yourself.",
      "end": true
    },
    {
      "id": "leave", "speaker": "player",
      "text": "Perhaps you are right. Any further conversation would be useless anyway. So I'll leave you ... for now!",
      "end": true
    }
  ]
}
