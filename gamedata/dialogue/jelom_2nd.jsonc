{
  "id": "jelom_2nd",
  "start": [
    { "node": "initial_report", "when": { "flag": "convince_jelom", "equals": 0 } },
    { "node": "still_unconvinced", "when": { "flag": "convince_jelom", "equals": 1 } },
    { "node": "erek_arrives", "when": { "flag": "convince_jelom", "equals": 2 } },
    { "node": "returned_from_fingolson" }
  ],
  "speakers": [
    { "id": "player", "name": "Banec", "role": "player",
      "portrait": "assets/ui/portraits/player.png" },
    { "id": "jelom", "name": "Jelom Rasgar", "role": "npc", "entity": "jelom",
      "portrait": "assets/ui/portraits/jelom.png" },
    { "id": "erek", "name": "Erek Stonebreaker", "role": "npc", "entity": "erek",
      "portrait": "assets/ui/portraits/erek.png" }
  ],
  "nodes": [
    {
      "id": "initial_report", "speaker": "jelom",
      "text": "Back again, Half-Elf? Have you learned anything of importance from your mistress?",
      "choices": [
        { "text": "Nothing you'd be interested in, Jelom.", "next": "nothing_new" },
        { "text": "It seems that Fingolson's gems are worthless to her.",
          "when": { "flag": "gem_worthless", "equals": 1 }, "next": "asks_for_proof" },
        { "text": "It seems that Fingolson's gems are worthless to her.",
          "when": { "flag": "gem_worthless", "equals": 2 }, "next": "asks_for_proof" },
        { "text": "It seems that Fingolson's gems are worthless to her.",
          "when": { "flag": "gem_worthless", "equals": 3 }, "next": "asks_for_proof" }
      ]
    },
    { "id": "nothing_new", "speaker": "player",
      "text": "Nothing you'd be interested in, Jelom.", "end": true },
    { "id": "asks_for_proof", "speaker": "jelom",
      "text": "Really? I imagine you have some sort of proof for this, then?",
      "choices": [
        { "text": "Lady Silverhair said so.",
          "when": { "flag": "gem_worthless", "equals": 1 }, "next": "silverhair_is_proof" },
        { "text": "Lady Silverhair said so.",
          "when": { "flag": "gem_worthless", "equals": 3 }, "next": "silverhair_is_proof" },
        { "text": "I'm just repeating Erek Stonebreaker's words.",
          "when": { "flag": "gem_worthless", "equals": 2 }, "next": "erek_is_proof" },
        { "text": "I'm just repeating Erek Stonebreaker's words.",
          "when": { "flag": "gem_worthless", "equals": 3 }, "next": "erek_is_proof" },
        { "text": "I have this Chrysoberyl. Apparently it is no Catseye, so why should Lady Silverhair have stolen it?",
          "when": { "flag": "have_gem", "equals": 1 }, "next": "show_gem" }
      ]
    },
    { "id": "silverhair_is_proof", "speaker": "player", "text": "Lady Silverhair said so.",
      "next": "dismisses_silverhair" },
    { "id": "dismisses_silverhair", "speaker": "jelom",
      "text": "Oh! The Lady Silverhair said so. I assure you Half-Elf, the Lady Silverhair said quite a lot when we put her under arrest, and it wasn't very lady-like. Come back once you have something more substantial!",
      "end": true },
    { "id": "erek_is_proof", "speaker": "player",
      "text": "I'm just repeating Erek Stonebreaker's words.", "next": "questions_erek" },
    { "id": "questions_erek", "speaker": "jelom",
      "text": "Now I'm surprised. What makes him believe all of a sudden that his Master is selling crap? That doesn't sound at all like the Erek I know.",
      "choices": [
        { "text": "If you don't believe me, go ask him yourself!", "next": "ask_erek_yourself" },
        { "text": "I showed him one of Fingolson's gems I found.", "next": "showed_erek_gem" }
      ]
    },
    { "id": "ask_erek_yourself", "speaker": "player",
      "text": "If you don't believe me, go ask him yourself!", "next": "jelom_keeps_post" },
    { "id": "jelom_keeps_post", "speaker": "jelom",
      "text": "And leave my post? Unlike Talan I do know my duty. Now go and don't bother me again before you can't prove your words.",
      "on_end": "record_jelom_needs_erek", "end": true },
    { "id": "showed_erek_gem", "speaker": "player",
      "text": "I showed him one of Fingolson's gems I found.", "next": "where_found" },
    { "id": "where_found", "speaker": "jelom",
      "text": "What? One of the stolen gems? Tell me Half-Elf, where have you found that?",
      "choices": [
        { "text": "It was hidden in Lady Silverhair's luggage.", "next": "gem_in_luggage" },
        { "text": "That's not important. The important thing is that this gem is of poor quality. See?", "next": "quality_only" }
      ]
    },
    { "id": "show_gem", "speaker": "player",
      "text": "I have this Chrysoberyl. Apparently it is no Catseye, so why should Lady Silverhair have stolen it?",
      "next": "stolen_gem" },
    { "id": "stolen_gem", "speaker": "jelom",
      "text": "You mean this is one of the stolen gems? How in hell did you come across that? And where are the others?",
      "choices": [
        { "text": "I don't know where the others are, but this one was hidden in Lady Silverhair's luggage.", "next": "gem_in_luggage_long" },
        { "text": "That's not important. The important thing is that this gem is of poor quality. See?", "next": "quality_only" }
      ]
    },
    { "id": "gem_in_luggage", "speaker": "player",
      "text": "It was hidden in Lady Silverhair's luggage.", "next": "contradiction" },
    { "id": "gem_in_luggage_long", "speaker": "player",
      "text": "I don't know where the others are, but this one was hidden in Lady Silverhair's luggage.", "next": "contradiction" },
    { "id": "contradiction", "speaker": "jelom",
      "text": "Slow down! Didn't you just claim that your mistress had no use for the gems? And now you're telling me that you found that one amongst her stuff. That makes no sense!",
      "next": "framed" },
    { "id": "framed", "speaker": "jelom",
      "text": "Unless the real thief wanted to direct all suspicion to your mistress. Ha! Nice idea, Half-elf. But why should I believe that your gem really belongs to Fingolson?",
      "next": "no_other_suspect" },
    { "id": "quality_only", "speaker": "player",
      "text": "That's not important. The important thing is that this gem is of poor quality. See?",
      "next": "not_an_expert" },
    { "id": "not_an_expert", "speaker": "jelom",
      "text": "Well, to me it looks valuable enough. Of course I am no expert in these matters, and I doubt that you are.",
      "next": "no_other_suspect" },
    { "id": "no_other_suspect", "speaker": "jelom",
      "text": "Oh no! You are Silverhair's loyal servant. And as long as there is no other suspect I cannot possibly trust in anything you say. Now take your gem and leave me alone!",
      "on_end": "record_jelom_needs_erek", "end": true },

    { "id": "still_unconvinced", "speaker": "jelom",
      "text": "Not you again, Half-Elf? Are you still trying to make me believe that your Mistress has no use for the gems?",
      "choices": [
        { "text": "I'm just repeating Erek Stonebreaker's words.",
          "when": { "flag": "gem_worthless", "equals": 2 }, "next": "erek_is_proof" },
        { "text": "I'm just repeating Erek Stonebreaker's words.",
          "when": { "flag": "gem_worthless", "equals": 3 }, "next": "erek_is_proof" },
        { "text": "I have this Chrysoberyl. Apparently it is no Catseye, so why should Lady Silverhair have stolen it?",
          "when": { "flag": "have_gem", "equals": 1 }, "next": "show_gem" },
        { "text": "I'd be just wasting my breath on you!", "next": "wasting_breath" }
      ]
    },
    { "id": "wasting_breath", "speaker": "player",
      "text": "I'd be just wasting my breath on you!", "end": true },

    { "id": "erek_arrives", "speaker": "jelom",
      "text": "What's going on now? What are you doing here, Erek Stonebreaker?",
      "next": "erek_testifies" },
    { "id": "erek_testifies", "speaker": "erek",
      "text": "I'm here on behalf of Banec, master Rasgar. I can testify that his gem belongs to my Master, and that it is of insufficient quality to be of any use for the Lady Silverhair.",
      "next": "jelom_warns_erek" },
    { "id": "jelom_warns_erek", "speaker": "jelom",
      "text": "I should have known it! Believe me Erek, these Half-Elves are talking you into things you will regret later on. Is it not so, Half-Elf?",
      "choices": [
        { "text": "Listen Jelom, I am getting sick of you. What is it you want?", "next": "sick_of_jelom" },
        { "text": "You think that I deceived Erek?", "next": "deceived_erek" }
      ]
    },
    { "id": "sick_of_jelom", "speaker": "player",
      "text": "Listen Jelom, I am getting sick of you. What is it you want?", "next": "jelom_wants_certainty" },
    { "id": "jelom_wants_certainty", "speaker": "jelom",
      "text": "I want to be sure, that's all. I told you that I don't trust you in this matter. And you Erek, you might think that you know the truth, but perhaps it's just what your friend here made you believe.",
      "next": "ask_fingolson" },
    { "id": "ask_fingolson", "speaker": "jelom",
      "text": "If this gem really belongs to Master Fingolson, why don't I hear what he has to say about it?",
      "choices": [
        { "text": "Well, Master Fingolson is pretending that this gem is a valuable Catseye, despite the fact that it isn't.",
          "when": { "flag": "bjarn_lies", "equals": 1 }, "next": "fingolson_lies" },
        { "text": "Uh, I haven't asked him yet.", "next": "not_asked_fingolson" }
      ]
    },
    { "id": "deceived_erek", "speaker": "player",
      "text": "You think that I deceived Erek?", "next": "jelom_suspicious" },
    { "id": "jelom_suspicious", "speaker": "jelom",
      "text": "I wouldn't be surprised. And I find it more than suspicious that I heard nothing from the gem's owner yet. If it really belongs to Master Fingolson, he should be able to give reliable information.",
      "choices": [
        { "text": "Well, Master Fingolson is pretending that this gem is a valuable Catseye, despite the fact that it isn't.",
          "when": { "flag": "bjarn_lies", "equals": 1 }, "next": "fingolson_lies" },
        { "text": "Uh, I haven't asked him yet.", "next": "not_asked_fingolson" }
      ]
    },
    { "id": "not_asked_fingolson", "speaker": "player",
      "text": "Uh, I haven't asked him yet.", "next": "jelom_waits" },
    { "id": "jelom_waits", "speaker": "jelom",
      "text": "Perhaps you should do that then, Half-Elf. I'll be waiting here.",
      "on_end": "record_jelom_waits_for_fingolson", "end": true },
    { "id": "fingolson_lies", "speaker": "player",
      "text": "Well, Master Fingolson is pretending that this gem is a valuable Catseye, despite the fact that it isn't.",
      "next": "asks_erek_truth" },
    { "id": "asks_erek_truth", "speaker": "jelom", "text": "Is that true, Erek?",
      "next": "erek_confirms_lie" },
    { "id": "erek_confirms_lie", "speaker": "erek",
      "text": "Banec's gem is definitely no Catseye, master Rasgar. I hate to admit, but Master Fingolson appears to be ... lying!",
      "next": "gather_everyone" },
    { "id": "gather_everyone", "speaker": "jelom",
      "text": "Now I understand nothing at all. Listen you both, I have enough of this! We are going to see this Dwarf. And Lady Silverhair is coming with us. I want to hear what she has to say to all of this.",
      "on_end": "finish_jelom_investigation", "end": true },

    { "id": "returned_from_fingolson", "speaker": "jelom",
      "text": "It's about time you return, Half-Elf! Tell me, what does Master Fingolson say about this gem of yours?",
      "choices": [
        { "text": "Nothing. He refused to talk with me!",
          "when": { "flag": "bjarn_door_open", "equals": 0 }, "next": "fingolson_refused" },
        { "text": "Nothing. He refused to talk with me!",
          "when": { "flag": "bjarn_door_open", "equals": 1 }, "next": "fingolson_refused" },
        { "text": "Nothing. He refused to talk with me!",
          "when": { "flag": "bjarn_door_open", "equals": 2 }, "next": "fingolson_refused" },
        { "text": "Well, Master Fingolson is pretending that this gem is a valuable Catseye, despite the fact that it isn't.",
          "when": { "flag": "bjarn_lies", "equals": 1 }, "next": "fingolson_lies" }
      ]
    },
    { "id": "fingolson_refused", "speaker": "player",
      "text": "Nothing. He refused to talk with me!", "next": "dismisses_failed_attempt" },
    { "id": "dismisses_failed_attempt", "speaker": "jelom",
      "text": "Ha, that's laughable. You want to solve this matter, and don't even manage to speak to Master Fingolson!? Out of my sight, and don't even think about coming back before you haven't talked to the Dwarf!",
      "end": true }
  ]
}
