  "speakers": [
    {
      "id": "player",
      "name": "Banec",
      "role": "player",
      "portrait": "assets/ui/portraits/player.png"
    },
    {
      "id": "lucia",
      "name": "Lucia Redwyne",
      "role": "npc",
      "entity": "lucia",
      "portrait": "assets/ui/portraits/lucia.png"
    },
    {
      "id": "narrator",
