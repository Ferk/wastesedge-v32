  "nodes": [
    { "id": "title", "speaker": "credits", "text": "V32\n- Waste's Edge -\n\nDirected by Alexandre Courbot and Kai Sterker\n\nPorted by Fernando Carmona Varo", "next": "writing" },
    { "id": "writing", "speaker": "credits", "text": "Written by Kai Sterker, Mike Nieforth and Josh Glover\n\nBased on an original idea by Kai Sterker", "next": "cast_one" },
    { "id": "cast_one", "speaker": "credits", "text": "Cast\n\nBanec - you\nImoen Silverhair - herself\nBjarn Fingolson - himself\nErek Stonebreaker - himself\nOrloth Redwyne - himself\nAlek Endhelm - himself", "next": "cast_two" },
    { "id": "cast_two", "speaker": "credits", "text": "Oliver Redwyne - himself\nTalan Wendth - himself\nJelom Rasgar - himself\nTristan Illig - himself\nFellnir Kezular - himself\nLucia Redwyne - herself", "next": "cast_three" },
    { "id": "cast_three", "speaker": "credits", "text": "Rhayne Frostbloom - herself\nSarin Trailfollower - himself\nJanesta Skywind - herself\n\nMrs. Frostbloom's assistant: Yeti\nCasting: Benjamin Walther-Franks", "next": "production" },
    { "id": "production", "speaker": "credits", "text": "Director of photography: Alexandre Courbot\nArt director: James Nash\nAssistant art director: Benjamin Walther-Franks\nWardrobe: Benjamin Walther-Franks\nMusic and foley: Joseph Toscano", "next": "thanks" },
    { "id": "thanks", "speaker": "credits", "text": "This port was possible thanks to the Adonthell team and the team behind the Vircon32 platform.", "next": "no_yetis" },
    { "id": "no_yetis", "speaker": "credits", "text": "No Yetis were harmed during the production of this game.", "next": "end" },
    { "id": "end", "speaker": "credits", "text": "The END",
      "on_end": "finish_extro", "end": true }
