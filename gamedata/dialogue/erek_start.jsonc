{
  "id": "erek_start",
  "start": [
    { "node": "gem_truth_retry", "when": { "flag": "erek_gem_refused", "equals": 1 } },
    { "node": "repeat_narration", "when": { "flag": "erek_talked", "equals": 1 } },
    { "node": "first_narration" }
  ],
  "speakers": [
    { "id": "player", "name": "Banec", "role": "player",
      "portrait": "assets/ui/portraits/player.png" },
    { "id": "erek", "name": "Erek Stonebreaker", "role": "npc", "entity": "erek",
      "portrait": "assets/ui/portraits/erek.png" },
    { "id": "silverhair", "name": "Imoen Silverhair", "role": "npc" },
    { "id": "bjarn", "name": "Bjarn Fingolson", "role": "npc" },
    { "id": "narrator", "name": "Narrator", "role": "narrator" }
  ],
  "nodes": [
    {
      "id": "first_narration", "speaker": "narrator",
      "text": "Before you stands a young Dwarf, with an open face and no sign of the traditional beard. His expression shows his intelligence and a trace of humour as he watches you expectantly.",
      "next": "identify"
    },
    {
      "id": "identify", "speaker": "player",
      "text": "You are Erek Stonebreaker, aren't you?",
      "next": "erek_identity"
    },
    {
      "id": "erek_identity", "speaker": "erek",
      "text": "That I am. Erek Stonebreaker, aspirant to the trading business and Master Fingolson's apprentice. But I seem to not remember you, sir.",
      "choices": [
        { "text": "I am Banec.",
          "actions": [{ "op": "set", "flag": "erek_talked", "value": 1 }],
          "next": "business_redirect" },
        { "text": "I am Banec, Lady Silverhair's man. I have some questions.",
          "actions": [{ "op": "set", "flag": "erek_talked", "value": 1 }],
          "next": "incident" }
      ]
    },
    {
      "id": "business_redirect", "speaker": "erek",
      "text": "Well met then, Banec. Only I fear that you would be better advised to talk to Master Fingolson, if you intend to do business.",
      "choices": [
        { "text": "Actually, that isn't the case. I would like to speak to you about Lady Silverhair.", "next": "incident" }
      ]
    },
    {
      "id": "incident", "speaker": "erek",
      "text": "I understand. You have learned of the ... incident, but as I can see, you fail to believe it.",
      "choices": [
        { "text": "You believe Lady Silverhair is innocent then?", "next": "uncertain" },
        { "text": "Well, what do you believe, Erek?", "next": "uncertain" }
      ]
    },
    {
      "id": "uncertain", "speaker": "erek",
      "text": "Master Fingolson says her guilt is proven beyond doubt, and there are indeed facts that support his opinion. But I ... am not sure.",
      "next": "main_menu"
    },
    {
      "id": "repeat_narration", "speaker": "narrator",
      "text": "Erek gives you a welcoming nod as you approach.",
      "next": "main_menu"
    },
    {
      "id": "main_menu", "speaker": "erek",
      "text": "Ho there, Banec. What is it this time?",
      "choices": [
        { "text": "Could you please repeat what you told me about the argument between your master and Lady Silverhair?",
          "actions": [
            { "op": "set", "flag": "know_low_quality", "value": 1 },
            { "op": "set", "flag": "know_argument", "value": 1 }
          ],
          "next": "argument_intro" },
        { "text": "Did you pack Master Fingolson's gems that evening, Erek?",
          "when": { "flag": "ask_packed_gems", "equals": 1 },
          "actions": [{ "op": "set", "flag": "ask_packed_gems", "value": 2 }],
          "next": "packed_answer" },
        { "text": "I tried to talk with Master Fingolson, but he would not open the door. Could you have a word with him perhaps?",
          "when": { "flag": "bjarn_door_open", "equals": 1 },
          "next": "fingolson_refusal" },
        { "text": "Jelom will not believe that the gem I have would be worthless to my mistress. But perhaps you could convince him.",
          "when": {
            "all": [
              { "flag": "convince_jelom", "equals": 1 },
              { "flag": "gem_worthless", "equals": 2 }
            ]
          },
          "actions": [{ "op": "set", "flag": "convince_jelom", "value": 2 }],
          "next": "erek_agrees_jelom" },
        { "text": "Jelom will not believe that the gem I have would be worthless to my mistress. But perhaps you could convince him.",
          "when": {
            "all": [
              { "flag": "convince_jelom", "equals": 1 },
              { "flag": "gem_worthless", "equals": 3 }
            ]
          },
          "actions": [{ "op": "set", "flag": "convince_jelom", "value": 2 }],
          "next": "erek_agrees_jelom" },
        { "text": "Erek, I'd like to hear your opinion about the gem I have here.",
          "when": { "flag": "have_gem", "equals": 1 },
          "next": "erek_recognizes_gem" },
        { "text": "Nothing really. Until later, Erek.", "next": "goodbye" }
      ]
    },
    {
      "id": "argument_intro", "speaker": "erek",
      "text": "She intended to buy some rare gems, but it seemed she had underestimated their value. She was quite surprised by my Master's offer:",
      "next": "silverhair_offer"
    },
    {
      "id": "silverhair_offer", "speaker": "silverhair",
      "text": "Why, Master Fingolson, this is outrageous. 'Tis twice as much as I would spend for stones of a superior quality. Do you believe I have never traded for Chrysoberyls before?",
      "next": "bjarn_price"
    },
    {
      "id": "bjarn_price", "speaker": "bjarn",
      "text": "My Lady, these Catseyes are very rare. I doubt that you could aquire anything of that quality for the price I'm willing to grant you.",
      "next": "silverhair_counter"
    },
    {
      "id": "silverhair_counter", "speaker": "silverhair",
      "text": "Now Master Fingolson, you call these Catseyes? They are mere Cymophanes. Good gods! I am no Dwarf, but I do know my gems. My offer is 200, for all the good they will be to me as reagents.",
      "next": "bjarn_counter"
    },
    {
      "id": "bjarn_counter", "speaker": "bjarn",
      "text": "You call me a liar? As if I couldn't tell a Catseye and a Cymophane apart. Even young Erek here can. 700 and no less. Take it or leave it.",
      "next": "silverhair_final"
    },
    {
      "id": "silverhair_final", "speaker": "silverhair",
      "text": "Ha! A liar and a thief you are indeed, Master Fingolson. But, I need the stones far more than justice against a Dwarven cheat. 300 is my final offer, and that is more than this rubbish deserves!",
      "next": "bjarn_refusal"
    },
    {
      "id": "bjarn_refusal", "speaker": "bjarn",
      "text": "Do not try to charm me, Mistress Silverhair. My prize is set. Think about it.",
      "next": "silverhair_leaves"
    },
    {
      "id": "silverhair_leaves", "speaker": "silverhair",
      "text": "You are but making profit off my need. I will think about it, but to be frank, you deserve not a single gold piece!",
      "next": "erek_end_argument"
    },
    {
      "id": "erek_end_argument", "speaker": "erek",
      "text": "And with that, she left us alone.",
      "next": "main_menu"
    },
    {
      "id": "packed_answer", "speaker": "erek",
      "text": "Me? What a curious idea! My master wouldn't give them out of his hands. I only packed our clothes and other equipment; after the master went to bed.",
      "next": "packed_followup"
    },
    {
      "id": "packed_followup", "speaker": "player",
      "text": "And the gems were not in your luggage when you packed, right?",
      "next": "packed_denial"
    },
    {
      "id": "packed_denial", "speaker": "erek",
      "text": "What do you mean? No ... they weren't. Of course not!",
      "next": "main_menu"
    },
    {
      "id": "fingolson_refusal", "speaker": "erek",
      "text": "I fear this is no good idea. He is still very upset about the theft and it is better not to bother him while he is in that mood.",
      "choices": [
        { "text": "Well, in that case I will leave him alone.", "next": "leave_fingolson_alone" },
        { "text": "I am trying to find his gems and he is not even willing to see me!?", "next": "fingolson_stubborn" }
      ]
    },
    {
      "id": "leave_fingolson_alone", "speaker": "player",
      "text": "Well, in that case I will leave him alone.",
      "end": true
    },
    {
      "id": "fingolson_stubborn", "speaker": "player",
      "text": "I am trying to find his gems and he is not even willing to see me!?",
      "next": "erek_obeys_master"
    },
    {
      "id": "erek_obeys_master", "speaker": "erek",
      "text": "You surely do. But Master Fingolson made it clear that he wants to be on his own and who am I to disobey his wishes?",
      "choices": [
        { "text": "I am trying to help here, Erek!",
          "actions": [{ "op": "set", "flag": "bjarn_door_open", "value": 2 }],
          "next": "erek_relents" }
      ]
    },
    {
      "id": "erek_relents", "speaker": "erek",
      "text": "I ... I'll see what I can do. But should you talk with him, you will have to watch your words. I surely won't be able to change his mind a second time.",
      "next": "erek_beckons"
    },
    {
      "id": "erek_beckons", "speaker": "narrator",
      "text": "Seemingly reluctant, Erek beckons you to follow him down into the cellar.",
      "on_end": "escort_to_fingolson_room",
      "end": true
    },
    {
      "id": "erek_recognizes_gem", "speaker": "erek",
      "text": "That ... - it's one of the Master's. It must be. Where did you get that, Banec?",
      "choices": [
        { "text": "I found it in the pantry.", "next": "erek_doubts_gem_story" },
        { "text": "It was hidden in Lady Silverhair's luggage.", "next": "erek_requests_gem" }
      ]
    },
    {
      "id": "erek_doubts_gem_story", "speaker": "erek",
      "text": "But certainly it was not lying openly on the ground, was it?",
      "choices": [
        { "text": "No. It was hidden in Lady Silverhair's luggage.", "next": "erek_requests_gem" },
        { "text": "Obviously not. Now would you like to see it?", "next": "erek_examines_gem" },
        { "text": "I would rather not say.",
          "actions": [{ "op": "set", "flag": "erek_gem_refused", "value": 1 }],
          "next": "erek_needs_truth" }
      ]
    },
    {
      "id": "erek_needs_truth", "speaker": "erek",
      "text": "You don't trust me, Banec? In that case I'm sorry. Unless I know the truth about the gem, I cannot help you.",
      "end": true
    },
    {
      "id": "gem_truth_retry", "speaker": "narrator",
      "text": "Erek tries to keep a straight face, but he fails to hide his grin as you address him.",
      "next": "erek_ready_for_truth"
    },
    {
      "id": "erek_ready_for_truth", "speaker": "erek",
      "text": "Well, Banec, I was almost certain that it wouldn't take long to change your mind. I'm ready for the truth.",
      "choices": [
        { "text": "So it be. The gem was hidden in Lady Silverhair's luggage.",
          "actions": [{ "op": "set", "flag": "erek_gem_refused", "value": 0 }],
          "next": "erek_examines_gem" },
        { "text": "I am not ready to tell you yet.", "next": "erek_needs_truth" }
      ]
    },
    {
      "id": "erek_requests_gem", "speaker": "erek",
      "text": "Then your mistress is not as innocent as you thought, no? Let me see the gem, please.",
      "next": "erek_examines_gem"
    },
    {
      "id": "erek_examines_gem", "speaker": "narrator",
      "text": "Carefully, Erek takes the gem and examines it closely for a while. Suddenly, he tosses it high into the air, a sparkling green star, gleaming in the light of the fire.",
      "next": "erek_returns_gem"
    },
    {
      "id": "erek_returns_gem", "speaker": "narrator",
      "text": "Once caught again, the young Dwarf shakes his head and starts to smile. Finally, he returns the gem.",
      "next": "erek_identifies_gem"
    },
    {
      "id": "erek_identifies_gem", "speaker": "erek",
      "text": "This is a fine example of a Chrysoberyl. Perfectly suitable for a Lady's ring, were that your Mistress' intention. However, it is no Catseye and as such it is of no use in the workings of magic she had in mind, if I recall correctly.",
      "choices": [
        { "text": "Could you repeat that for Jelom? He would not believe me.",
          "when": {
            "all": [
              { "flag": "convince_jelom", "equals": 1 },
              { "flag": "gem_worthless", "equals": 0 }
            ]
          },
          "actions": [
            { "op": "set", "flag": "gem_worthless", "value": 2 },
            { "op": "set", "flag": "convince_jelom", "value": 2 }
          ],
          "next": "erek_agrees_jelom" },
        { "text": "Could you repeat that for Jelom? He would not believe me.",
          "when": {
            "all": [
              { "flag": "convince_jelom", "equals": 1 },
              { "flag": "gem_worthless", "equals": 1 }
            ]
          },
          "actions": [
            { "op": "set", "flag": "gem_worthless", "value": 3 },
            { "op": "set", "flag": "convince_jelom", "value": 2 }
          ],
          "next": "erek_agrees_jelom" },
        { "text": "Thank you Erek. That's all I need to know.",
          "when": { "flag": "gem_worthless", "equals": 0 },
          "actions": [{ "op": "set", "flag": "gem_worthless", "value": 2 }],
          "next": "erek_gem_thanks" },
        { "text": "Thank you Erek. That's all I need to know.",
          "when": { "flag": "gem_worthless", "equals": 1 },
          "actions": [{ "op": "set", "flag": "gem_worthless", "value": 3 }],
          "next": "erek_gem_thanks" }
      ]
    },
    {
      "id": "erek_gem_thanks", "speaker": "player",
      "text": "Thank you Erek. That's all I need to know.",
      "end": true
    },
    {
      "id": "erek_agrees_jelom", "speaker": "erek",
      "text": "Of course, Banec. Let's go and see him.",
      "on_end": "escort_erek_to_jelom",
      "end": true
    },
    {
      "id": "goodbye", "speaker": "player",
      "text": "Nothing really. Until later, Erek.",
      "end": true
    }
  ]
}
