{
  "id": "begin_extro_aftermath",
  "actions": [
    { "op": "play_music", "track": "extro_confession" },

    { "op": "speak", "entity": "bjarn", "text": "There is no denying it. Yes, I feigned the theft.", "duration_frames": 180 },
    { "op": "wait", "frames": 180 },
    { "op": "speak", "entity": "erek", "text": "But Master? How could you do such an infamous deed?", "duration_frames": 180 },
    { "op": "wait", "frames": 180 },
    { "op": "speak", "entity": "jelom", "text": "That I would know as well! And where are the gems then?", "duration_frames": 180 },
    { "op": "wait", "frames": 180 },
    { "op": "speak", "entity": "bjarn", "text": "What? Haven't I made myself clear already?", "duration_frames": 150 },
    { "op": "wait", "frames": 150 },
    { "op": "speak", "entity": "bjarn", "text": "I despise those Elves and their uncanny ways.", "duration_frames": 180 },
    { "op": "wait", "frames": 180 },
    { "op": "speak", "entity": "bjarn", "text": "Their ... meddling with reality contradicts all principles I learnt to hold true.", "duration_frames": 240 },
    { "op": "wait", "frames": 240 },
    { "op": "speak", "entity": "bjarn", "text": "And yet, I had to provide them with the reagents they need to perform their dark art.", "duration_frames": 240 },
    { "op": "wait", "frames": 240 },
    { "op": "speak", "entity": "bjarn", "text": "I felt so ... ashamed!", "duration_frames": 150 },
    { "op": "wait", "frames": 150 },
    { "op": "speak", "entity": "player", "text": "And you believe this justifies the discomfort you caused my mistress?", "duration_frames": 210 },
    { "op": "wait", "frames": 210 },
    { "op": "speak", "entity": "bjarn", "text": "You cannot think further than your mistress, can you?", "duration_frames": 180 },
    { "op": "wait", "frames": 180 },
    { "op": "speak", "entity": "bjarn", "text": "Theft by a high born like Lady Silverhair would have been considered a grave insult by the clan elders.", "duration_frames": 270 },
    { "op": "wait", "frames": 270 },
    { "op": "speak", "entity": "bjarn", "text": "Had she been convicted, they might have chosen to cease trading with her likes.", "duration_frames": 240 },
    { "op": "wait", "frames": 240 },
    { "op": "speak", "entity": "bjarn", "text": "It might have been years before any Elf got his filthy hands on our beloved gems again!", "duration_frames": 240 },
    { "op": "wait", "frames": 240 },
    { "op": "speak", "entity": "silverhair", "text": "I feared as much and I feared the consequences.", "duration_frames": 180 },
    { "op": "wait", "frames": 180 },
    { "op": "speak", "entity": "silverhair", "text": "Without the arcane arts my kind would soon succumb to the human tides.", "duration_frames": 210 },
    { "op": "wait", "frames": 210 },
    { "op": "speak", "entity": "silverhair", "text": "But without gems and ores purchased from the small folk we cannot create magic.", "duration_frames": 240 },
    { "op": "wait", "frames": 240 },
    { "op": "speak", "entity": "jelom", "text": "Who would have thought that?", "duration_frames": 150 },
    { "op": "wait", "frames": 150 },
    { "op": "speak", "entity": "jelom", "text": "Seems you owe Banec here a big favour, if I may say so, Lady.", "duration_frames": 210 },
    { "op": "wait", "frames": 210 },
    { "op": "speak", "entity": "silverhair", "text": "Rest assured that Banec's deeds will not be forgotten, good man.", "duration_frames": 210 },
    { "op": "wait", "frames": 210 },
    { "op": "speak", "entity": "jelom", "text": "Well, this is settled then. What remains now are the whereabouts of the gems.", "duration_frames": 240 },
    { "op": "wait", "frames": 240 },
    { "op": "speak", "entity": "jelom", "text": "Master Fingolson!", "duration_frames": 120 },
    { "op": "wait", "frames": 120 },

    { "op": "walk_actor", "entity": "bjarn", "scene": "redwyne_fingolson_room",
      "x": 7, "y": 3, "facing": "north" },
    { "op": "wait_actor", "entity": "bjarn" },
    { "op": "show_dialogue", "dialogue": "extro_chest" }
  ]
}
